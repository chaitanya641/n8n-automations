    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "rows = []\n\nfor item in _items:\n    p = item[\"json\"]\n    rows.append({\n        \"product_id\": p[\"id\"],\n        \"product\": p[\"title\"],\n        \"order_date\": p[\"order_date\"],\n        \"price\": round(float(p[\"price\"]), 2),\n        \"quantity\": int(p[\"quantity\"]),\n        \"total_amount\": round(float(p[\"total\"]), 2),\n        \"discounted_amount\": round(float(p[\"discountedTotal\"]), 2),\n    })\n\n# Z-score on total_amount\namounts = [r[\"total_amount\"] for r in rows]\nn = len(amounts)\nmean = sum(amounts) / n\nvariance = sum((a - mean) ** 2 for a in amounts) / (n - 1) if n > 1 else 0\nstdev = variance ** 0.5\n\noutput = []\nfor r in rows:\n    z = (r[\"total_amount\"] - mean) / stdev if stdev else 0\n    r[\"z_score\"] = round(z, 2)\n    r[\"is_anomaly\"] = abs(z) > 2\n    output.append({\"json\": r})\n\nreturn output"
      },
